{
  "schemaVersion": 1,
  "provider": "vercel",
  "adapter": {
    "name": "nitro",
    "version": "3.0.260610-beta",
    "preset": "vercel",
    "buildOutputApiVersion": 3
  },
  "build": {
    "installCommand": "npm ci",
    "buildCommand": "npm run deploy:vercel",
    "outputDirectory": ".vercel/output"
  },
  "installation": {
    "method": "vercel-deploy-button",
    "repositoryOwnership": "vercel-created",
    "requiredIntegrations": [
      {
        "type": "connectable",
        "slug": "app-builder"
      },
      {
        "type": "native-product",
        "slug": "neon",
        "productSlug": "neon",
        "protocol": "storage"
      }
    ],
    "databaseCredentialOwner": "vercel-marketplace:neon"
  },
  "environment": [
    {
      "name": "BETTER_AUTH_URL",
      "required": true,
      "secret": false,
      "source": "vercel-system-url",
      "phase": "runtime"
    },
    {
      "name": "BETTER_AUTH_SECRET",
      "required": true,
      "secret": true,
      "source": "generated",
      "phase": "runtime"
    },
    {
      "name": "DATABASE_URL",
      "required": true,
      "secret": true,
      "source": "vercel-marketplace:neon",
      "phase": "build-runtime"
    },
    {
      "name": "APP_BUILDER_DELIVERY_STAGE",
      "required": true,
      "secret": false,
      "source": "generated",
      "phase": "build-runtime"
    },
    {
      "name": "APP_ENVIRONMENT_ID",
      "required": true,
      "secret": false,
      "source": "generated",
      "phase": "runtime"
    },
    {
      "name": "APP_BUILDER_CONTROL_PLANE_URL",
      "required": true,
      "secret": false,
      "source": "generated",
      "phase": "runtime"
    },
    {
      "name": "APP_BUILDER_PROJECT_ID",
      "required": true,
      "secret": false,
      "source": "generated",
      "phase": "runtime"
    },
    {
      "name": "APP_BUILDER_FEATURE_FLAG_RUNTIME_TOKEN",
      "required": true,
      "secret": true,
      "source": "generated",
      "phase": "runtime"
    },
    {
      "name": "APP_BUILDER_ENTITLED_ORGANIZATION_IDS",
      "required": false,
      "secret": false,
      "source": "user",
      "phase": "runtime"
    },
    {
      "name": "GITHUB_APP_CLIENT_ID",
      "required": false,
      "secret": false,
      "source": "user",
      "phase": "runtime"
    },
    {
      "name": "GITHUB_APP_CLIENT_SECRET",
      "required": false,
      "secret": true,
      "source": "user",
      "phase": "runtime"
    }
  ],
  "routes": {
    "application": "/",
    "publicApi": "/api/v1",
    "health": "/api/v1/health",
    "openapi": "/api/v1/openapi.json",
    "identityCallback": "/api/auth/callback/github"
  },
  "runtime": {
    "node": "24.x",
    "regions": []
  },
  "securityHeaders": [
    "Strict-Transport-Security",
    "X-Content-Type-Options",
    "X-Frame-Options",
    "Referrer-Policy",
    "Permissions-Policy"
  ],
  "verification": {
    "requireExactCommit": true,
    "checks": [
      "migration",
      "application",
      "health",
      "api-version",
      "openapi",
      "security-headers"
    ]
  },
  "previewMigration": {
    "command": "npm run migrate",
    "stageVariable": "APP_BUILDER_DELIVERY_STAGE",
    "runWhen": "PREVIEW",
    "productionExecutor": "trusted-release"
  }
}
