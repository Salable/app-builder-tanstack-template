{
  "name": "@app-builder/generated-tanstack-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "build": "npm run generate && vite build",
    "build:vercel": "NITRO_PRESET=vercel npm run build",
    "check": "npm run typecheck && npm run build && npm run check:deployment && npm run generate:check && npm test",
    "check:deployment": "node --import tsx scripts/check-deployment-manifest.ts",
    "check:deployment:built": "node --import tsx scripts/check-deployment-manifest.ts --built",
    "dev": "vite dev",
    "generate": "npm run generate:openapi && npm run generate:sdk",
    "generate:check": "npm run generate && npm run check:compatibility && git diff --exit-code -- openapi src/api/generated",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts",
    "generate:sdk": "orval --config orval.config.ts && prettier --write \"src/api/generated/**/*.ts\"",
    "check:compatibility": "node --import tsx scripts/check-openapi-compatibility.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "migrate:rollback": "node --import tsx scripts/migrate.ts --rollback",
    "start": "node .output/server/index.mjs",
    "test": "vitest run && npm run test:ssr",
    "test:integration": "node --import tsx scripts/run-postgres-integration.ts",
    "test:ssr": "node --import tsx scripts/smoke-ssr.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hono/zod-openapi": "1.5.1",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "better-auth": "1.6.24",
    "hono": "4.12.31",
    "nitro": "3.0.260610-beta",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "28.1.0",
    "orval": "8.22.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
