{
  "name": "@app-builder/generated-tanstack-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "build": "npm run generate && NODE_ENV=production vite build",
    "build:vercel": "NITRO_PRESET=vercel npm run build",
    "deploy:vercel": "node --import tsx scripts/deploy-vercel.ts",
    "check": "npm run check:quality && npm run test:unit && npm run test:integration && npm run check:build",
    "check:build": "npm run build && npm run test:ssr && npm run build:vercel && npm run check:deployment:built",
    "check:quality": "npm run format:check && npm run lint && npm run typecheck && npm run check:feature-flags && npm run check:deployment && npm run generate:check",
    "check:deployment": "node --import tsx scripts/check-deployment-manifest.ts",
    "check:deployment:built": "node --import tsx scripts/check-deployment-manifest.ts --built",
    "check:feature-flags": "node --import tsx scripts/check-feature-flags.ts",
    "dev": "vite dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "generate": "npm run generate:openapi && npm run generate:sdk",
    "generate:check": "npm run generate && git diff --exit-code -- openapi src/api/generated",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts",
    "generate:sdk": "orval --config orval.config.ts && prettier --write \"src/api/generated/**/*.ts\" && node --import tsx scripts/patch-generated-client.ts && prettier --write \"src/api/generated/**/*.ts\"",
    "migrate": "node --import tsx scripts/migrate.ts",
    "migrate:rollback": "node --import tsx scripts/migrate.ts --rollback",
    "lint": "eslint . --max-warnings=0",
    "start": "node .output/server/index.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "node --import tsx scripts/run-postgres-integration.ts && node --import tsx --test scripts/neon-auth.integration.test.ts",
    "test:ssr": "node --import tsx scripts/smoke-ssr.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hono/zod-openapi": "1.5.1",
    "@hookform/resolvers": "5.4.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "better-auth": "1.6.24",
    "hono": "4.13.1",
    "nitro": "3.0.260610-beta",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "28.1.0",
    "orval": "8.34.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tough-cookie": "6.0.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
